# Genox Environment Configuration
# Get your 100% FREE Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Model configuration (Gemini 2.5 Flash is recommended for speed and tool use)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
GENOX_MODEL=gemini-2.5-flash

# Web Dashboard Server Port
GENOX_PORT=8000
GENOX_HOST=127.0.0.1

# Working Directory for Agent File Operations (defaults to workspace)
GENOX_WORKSPACE=/Users/sujaydey/Documents/Genox/workspace
